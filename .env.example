# Neon console → Project → Connect → Node.js connection string
DATABASE_URL=

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long

# First account is created only when app_users is empty. Keep this out of Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Public evaluator demo login; the password intentionally matches the username.
DEMO_USERNAME=californiaburrito
DEMO_PASSWORD=californiaburrito

# Enable account creation so evaluators can access the dashboard.
ALLOW_REGISTRATION=true

NODE_ENV=development
PORT=3001
